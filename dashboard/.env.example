# Dashboard environment (copy to .env for local; set the same keys in Render build env)

# REQUIRED for Render / production builds — without this, the browser will call localhost
VITE_API_URL=https://YOUR-BACKEND.onrender.com/api/v1

# Local default (used automatically when VITE_API_URL is unset):
# VITE_API_URL=http://localhost:5000/api/v1
